# Copy to .env and fill in.  NEVER commit .env  (see M2-L19).
# .env is listed in .gitignore.

# ---------------------------------------------------------------------------
# Model provider (optional for Modules 1-9: a mock client ships with the course)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Alternatives, if you choose a different provider in M5-L17:
# OPENAI_API_KEY=

# Set to "mock" to run every lesson offline with the bundled fake model client,
# or "anthropic" / "bedrock" to use a real provider.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Database (Modules 2, 6, 7)
# ---------------------------------------------------------------------------
# SQLite is the zero-setup default used in early lessons.
DATABASE_URL=sqlite:///./course.db
# PostgreSQL + pgvector, introduced in M6-L08:
# DATABASE_URL=postgresql://course:course@localhost:5432/course

# ---------------------------------------------------------------------------
# AWS (Modules 11-12 only).  Leave blank until M11-L05.
# Prefer short-lived credentials or an SSO profile over long-lived keys.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=
# Do NOT put AWS_SECRET_ACCESS_KEY here if you can use a profile or SSO instead.

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=local
