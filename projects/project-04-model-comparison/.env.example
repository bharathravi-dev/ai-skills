# Project 4 runs fully offline with the mock provider and needs NONE of this.
#
# These variables exist only if you choose to point the harness at a real
# provider. NEVER commit a filled-in .env file. NEVER put a real key in
# .env.example. Rotate any key that reaches a repository (M2-L19).

# MODELCMP_PROVIDER=mock          # mock (default) | openai | anthropic
# MODELCMP_API_KEY=               # leave empty; export it in your shell instead
# MODELCMP_BASE_URL=
# MODELCMP_MAX_SPEND_USD=5.00     # the harness refuses to start above this
