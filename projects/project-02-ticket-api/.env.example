# Copy to .env and fill in. NEVER commit .env (M2-L19).
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=./tickets.db
# A comma-separated list of "token:user_id:role" triples.
# Real systems use an identity provider (M9-L11); this keeps the project
# self-contained and offline.
API_TOKENS=tok-alice:u-alice:agent,tok-bob:u-bob:agent,tok-admin:u-admin:admin
